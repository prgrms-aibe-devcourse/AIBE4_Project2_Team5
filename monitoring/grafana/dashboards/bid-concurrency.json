      "title": "Bid Outcome Count (selected range)",
      "type": "table",
      "description": "선택한 시간 범위에서 outcome별 누적 건수입니다. Time 컬럼은 사후 분석에 불필요하여 숨겼습니다.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "outcome": 0,
              "Value": 1
            },
            "renameByName": {
              "Value": "count"
            }
          }
        }
      ]
