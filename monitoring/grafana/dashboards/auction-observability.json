          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(auction_bid_outcome_total, outcome)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "allValue": ".*"
      }
    ]
  },
