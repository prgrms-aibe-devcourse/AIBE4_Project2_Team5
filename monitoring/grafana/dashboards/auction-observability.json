    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 13,
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "pluginVersion": "11.5.1",
      "targets": [
        {
          "expr": "sort_desc(sum by (outcome) (increase(auction_bid_outcome_total{outcome=~\"$outcome\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Bid Outcome Count (selected range)",
      "type": "table",
      "description": "선택한 시간 범위에서 outcome별 누적 건수입니다. Time 컬럼은 사후 분석에 불필요하여 숨겼습니다.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "outcome": 0,
              "Value": 1
            },
            "renameByName": {
              "Value": "count"
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 14,
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "pluginVersion": "11.5.1",
      "targets": [
        {
          "expr": "sort_desc(100 * sum by (outcome) (increase(auction_bid_outcome_total{outcome=~\"$outcome\"}[$__range])) / scalar(clamp_min(sum(increase(auction_bid_outcome_total{outcome=~\"$outcome\"}[$__range])), 1)))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Bid Outcome Ratio % (selected range)",
      "type": "table",
      "description": "선택한 시간 범위에서 outcome별 비율입니다. denominator를 scalar로 변환해 outcome label vector와 정상 계산되도록 수정했습니다.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "outcome": 0,
              "Value": 1
            },
            "renameByName": {
              "Value": "ratio %"
            }
          }
        }
      ]
    }
