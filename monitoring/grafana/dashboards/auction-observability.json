      "targets": [
        {
          "expr": "100 * (sum(rate(auction_bid_outcome_total{outcome=\"lock_busy\"}[5m])) or vector(0)) / clamp_min((sum(rate(auction_bid_request_total[5m])) or vector(0)), 0.0001)",
          "refId": "A"
        }
      ]
