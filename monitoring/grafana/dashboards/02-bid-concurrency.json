    {
      "id": 7,
      "title": "Lock Wait p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(auction_bid_lock_wait_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(auction_bid_lock_wait_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(auction_bid_lock_wait_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "description": "락을 기다린 시간. p95가 lock-timeout-ms 근처로 붙으면 대기 후 timeout 되는 패턴입니다."
    },
    {
      "id": 8,
      "title": "Lock Hold / Tx Duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(auction_bid_lock_hold_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "lock hold p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(auction_bid_transaction_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "tx p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(auction_bid_transaction_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "tx p99",
          "refId": "C"
        }
      ],
      "description": "락을 잡은 뒤 commit 까지 걸리는 시간. 여기 숫자가 길면 임계구역이 길다는 뜻입니다."
    },
    {
      "id": 9,
      "title": "Accepted vs Lock Busy vs Validation Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
