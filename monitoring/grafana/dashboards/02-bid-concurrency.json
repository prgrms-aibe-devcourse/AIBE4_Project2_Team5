          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(auction_bid_outcome_total{outcome=~\"accepted|accepted_extended\"}[1m]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "sum(rate(auction_bid_outcome_total{outcome=\"lock_busy\"}[1m]))",
          "legendFormat": "lock_busy",
          "refId": "B"
        },
        {
          "expr": "sum(rate(auction_bid_outcome_total{outcome=~\"invalid_amount|invalid_increment|amount_exceeds_limit|auction_not_live|seller_cannot_bid\"}[1m]))",
          "legendFormat": "validation",
          "refId": "C"
        }
